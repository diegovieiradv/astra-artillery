    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.47.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.0",
    "@types/node": "22.5.4",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "2.1.1",
    "eslint": "9.9.1",
    "eslint-config-next": "15.2.4",
    "jsdom": "25.0.0",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.10",
